# Template for one real machine. Copy to configs/machines/<name>.yaml
# (the file name must equal `name`), then fill in the values marked FILL.
# Real machine files are git-ignored because they hold owners' names and IPs.
name: machine-a
owner: ""                # FILL (optional)
address: null            # FILL: IPv4 of this machine on the network used for the run (VPN address when running over the internet)
device: cuda             # cuda | cpu
cuda_index: 0
num_workers: 2           # DataLoader processes
data_dir: ./data
download: true
max_batch: {}            # FILL from `python -m gpubench profile -m <name>`, e.g. {resnet20: 512}
network_interface: null  # adapter name; set it (e.g. Tailscale) when the machine has a VPN or several adapters
env: {}
notes: ""                # GPU model, VRAM, driver, OS
